<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Awesome Website</title>
    <!-- Link to our external CSS stylesheet -->
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Main container for our website content -->
    <header>
        <h1>Welcome to My Website!</h1>
        <p>Built with HTML, CSS, and JavaScript, hosted on GitHub Pages.</p>
    </header>

    <main>
        <section class="card">
            <h2>Interactive Section</h2>
            <p>Click the button below to see JavaScript in action!</p>
            <!-- A button that triggers a JavaScript function when clicked -->
            <button id="colorButton">Click Me!</button>
        </section>
    </main>

    <footer>
        <p>&copy; 2026 Future Developer. All rights reserved.</p>
    </footer>

    <!-- Link to our external JavaScript file -->
    <script src="script.js"></script>
</body>
</html>
